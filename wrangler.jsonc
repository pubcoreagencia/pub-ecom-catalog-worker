{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pub-ecom-catalog-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "services": [
    {
      "binding": "SHOPEE_SCRAPER_SERVICE",
      "service": "pub-shopee-scraper"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pub-ecom-master-catalog",
      "database_id": "9d565ef9-f1c5-4af0-ac91-52411ac88d45"
    }
  ]
}
