{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pub-ecom-catalog-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "services": [
    {
      "binding": "SHOPEE_SCRAPER_SERVICE",
      "service": "pub-shopee-scraper"
    }
  ]
}
